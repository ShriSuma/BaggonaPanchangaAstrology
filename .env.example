# =============================================================================
# Baggona Panchanga Astrology - Environment Variables Template
# Copy these key-value pairs into Vercel -> Project Settings -> Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE AI ENGINE (Gemini 3.5 Flash Lite) - HIGH PRIORITY
# -----------------------------------------------------------------------------
# Required for Kundli readings, Ayur Sanjeevini, Hindina Janma, Face/Palm reading,
# and daily personal predictions.
# Get free API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server-side key for Vercel Serverless Functions (/api/kundli-narrative, /api/premium-pdf-narrative)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (defaults to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# 2. SACRED VEDIC AUDIO & VOICE CLONING (AI Neural TTS)
# -----------------------------------------------------------------------------
# Custom Real-Time Streaming Studio TTS API Key
VITE_STUDIO_TTS_API_KEY=your_studio_tts_api_key_here

# AI4Bharat Indic-Parler-TTS (Hugging Face User Access Token for 22+ Indic languages)
# Get token at: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=your_huggingface_token_here
HF_TOKEN=your_huggingface_token_here

# Sarvam AI Indic Neural Voice Engine (Bulbul:v3 Indic Voice fallback)
# Get key at: https://dashboard.sarvam.ai
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# -----------------------------------------------------------------------------
# 3. DEVOTEE EMAIL & SEVA NOTIFICATIONS (/api/notify)
# -----------------------------------------------------------------------------
# API key from Resend (https://resend.com) for sending booking confirmations & priest alerts
RESEND_API_KEY=your_resend_api_key_here

# Alternative to Resend if using Brevo / Sendinblue (optional fallback)
# BREVO_API_KEY=your_brevo_api_key_here

# -----------------------------------------------------------------------------
# 4. TRANSLATION (5-Language Indic Localization)
# -----------------------------------------------------------------------------
# OPTION A: Free built-in proxy with GTX fallback (Default - zero config needed).
# OPTION B: Google Cloud Translation API Key (Server-side only, optional):
# GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translate_key_here

# -----------------------------------------------------------------------------
# 5. GOOGLE MAPS LOCATION PICKER (Optional)
# -----------------------------------------------------------------------------
# Google Maps JavaScript API key for interactive birth place map picker.
# If omitted, manual city/coordinates picker is used automatically.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# -----------------------------------------------------------------------------
# 6. ALTERNATIVE AI ENGINE (OpenAI Fallback - Optional)
# -----------------------------------------------------------------------------
# Only needed if you prefer OpenAI instead of Gemini for serverless narratives
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
